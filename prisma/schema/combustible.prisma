// Combustible: vales, estaciones y matriz D2

model CombustibleAuditoriaViaje {
  id               Int       @id @default(autoincrement())
  modulo           String    @default("operaciones") @db.VarChar(30)
  viaje            String    @db.VarChar(60)
  estado_auditoria String    @default("PENDIENTE") @db.VarChar(30)
  observacion      String?   @db.Text
  usuario          String?   @db.VarChar(100)
  creado_en        DateTime? @default(now()) @db.Timestamp(0)
  actualizado_en   DateTime? @default(now()) @db.Timestamp(0)

  @@unique([modulo, viaje], map: "uk_modulo_viaje")
  @@index([viaje], map: "idx_viaje")
  @@map("combustible_auditoria_viajes")
}

model CombustibleEstacionProveedor {
  id                     Int       @id @default(autoincrement())
  proveedor_razon_social String    @db.VarChar(200)
  proveedor_ruc          String?   @db.VarChar(20)
  estaciones_nombres     String    @db.Text
  created_at             DateTime? @default(now()) @db.Timestamp(0)
  updated_at             DateTime? @default(now()) @db.Timestamp(0)

  @@index([proveedor_razon_social], map: "idx_prov_rs")
  @@map("combustible_estaciones_proveedores")
}

model CombustibleMatrizD2 {
  id             Int       @id @default(autoincrement())
  sentido        String    @default("IDA") @db.VarChar(20)
  ruta           String    @db.VarChar(150)
  motor          String    @default("MC11.44") @db.VarChar(50)
  confg          String    @default("T3") @db.VarChar(20)
  km_0           Decimal   @default(0.00) @db.Decimal(10, 2)
  km_5           Decimal   @default(0.00) @db.Decimal(10, 2)
  km_10          Decimal   @default(0.00) @db.Decimal(10, 2)
  km_15          Decimal   @default(0.00) @db.Decimal(10, 2)
  km_20          Decimal   @default(0.00) @db.Decimal(10, 2)
  km_25          Decimal   @default(0.00) @db.Decimal(10, 2)
  km_30          Decimal   @default(0.00) @db.Decimal(10, 2)
  km             Decimal   @default(0.00) @db.Decimal(10, 2)
  estado         String    @default("ACTIVO") @db.VarChar(20)
  creado_en      DateTime? @default(now()) @db.Timestamp(0)
  actualizado_en DateTime? @default(now()) @db.Timestamp(0)

  @@index([motor, confg], map: "idx_motor_confg")
  @@index([ruta], map: "idx_ruta")
  @@map("combustible_matriz_d2")
}

model CombustibleVale {
  id                 Int       @id @default(autoincrement())
  fecha              DateTime  @db.DateTime(0)
  estado             String    @default("VÁLIDO") @db.VarChar(30)
  correlativo        String    @default("") @db.VarChar(50)
  estado_pago        String    @default("NO PAGADO") @db.VarChar(30)
  viaje              String    @default("") @db.VarChar(50)
  caja               String    @default("") @db.VarChar(50)
  estado_caja        String    @default("PENDIENTE") @db.VarChar(30)
  clase_vehiculo     String    @default("TRACTO") @db.VarChar(50)
  vehiculo           String    @default("") @db.VarChar(20)
  conductor          String    @default("") @db.VarChar(150)
  ruta               String    @default("") @db.VarChar(255)
  departamento       String    @default("") @db.VarChar(80)
  provincia          String    @default("") @db.VarChar(80)
  distrito           String    @default("") @db.VarChar(80)
  estacion           String    @default("") @db.VarChar(150)
  tipo_combustible   String    @default("D2") @db.VarChar(50)
  proveedor          String    @default("") @db.VarChar(200)
  ruc                String    @default("") @db.VarChar(20)
  kilometraje        Decimal   @default(0.00) @db.Decimal(12, 2)
  peso_tn            Decimal   @default(0.00) @db.Decimal(10, 2)
  galones            Decimal   @default(0.00) @db.Decimal(10, 2)
  costo_gl           Decimal   @default(0.00) @db.Decimal(10, 2)
  tipo_pago          String    @default("ANTICIPO") @db.VarChar(50)
  dias_credito       Int       @default(0)
  moneda             String    @default("SOLES") @db.VarChar(20)
  importe            Decimal   @default(0.00) @db.Decimal(12, 2)
  numero_comprobante String    @default("") @db.VarChar(50)
  tipo_cambio        Decimal?  @db.Decimal(8, 4)
  archivo_url        String?   @db.VarChar(255)
  observacion        String?   @db.Text
  tipo               String    @default("RECARGA VUELTA") @db.VarChar(80)
  creado_en          DateTime? @default(now()) @db.Timestamp(0)
  actualizado_en     DateTime? @default(now()) @db.Timestamp(0)
  id_remoto          Int?
  vehiculo_marca     String?   @db.VarChar(100)
  vehiculo_modelo    String?   @db.VarChar(100)

  @@index([correlativo], map: "idx_correlativo")
  @@index([estado], map: "idx_estado")
  @@index([fecha], map: "idx_fecha")
  @@index([fecha, estado], map: "idx_fecha_estado")
  @@index([vehiculo], map: "idx_vehiculo")
  @@index([vehiculo, fecha, viaje], map: "idx_vehiculo_fecha_viaje")
  @@index([viaje], map: "idx_viaje")
  @@map("combustible_vales")
}

