// Neumáticos: hoja de vida, inspecciones, rotaciones y catálogos

model CatNeumaticoAccion {
  id         Int       @id @default(autoincrement())
  nombre     String    @unique(map: "nombre") @db.VarChar(50)
  activo     Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  @@map("cat_neumaticos_acciones")
}

model CatNeumaticoMarca {
  id         Int       @id @default(autoincrement())
  nombre     String    @unique(map: "nombre") @db.VarChar(100)
  activo     Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  @@map("cat_neumaticos_marcas")
}

model CatNeumaticoMedida {
  id         Int       @id @default(autoincrement())
  nombre     String    @unique(map: "nombre") @db.VarChar(50)
  activo     Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  @@map("cat_neumaticos_medidas")
}

model CatNeumaticoModelo {
  id         Int       @id @default(autoincrement())
  nombre     String    @unique(map: "nombre") @db.VarChar(100)
  activo     Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  @@map("cat_neumaticos_modelos")
}

model NeumaticoHojaVida {
  id_neumatico      String                             @id @db.VarChar(50)
  codigo_dot        String?                            @db.VarChar(50)
  marca             String                             @db.VarChar(100)
  modelo            String                             @db.VarChar(100)
  medida            String                             @db.VarChar(50)
  estado            String?                            @default("NUEVA") @db.VarChar(30)
  remanente_inicial Int?                               @default(18)
  remanente_actual  Decimal?                           @default(18.0) @db.Decimal(4, 1)
  costo_compra      Decimal?                           @default(0.00) @db.Decimal(10, 2)
  km_acumulado      Int?                               @default(0)
  placa_actual      String?                            @db.VarChar(20)
  posicion_actual   String?                            @db.VarChar(10)
  estado_operativo  NeumaticosHojaVidaEstadoOperativo? @default(Stock_Taller)
  fecha_instalacion DateTime?                          @db.Date
  created_at        DateTime?                          @default(now()) @db.Timestamp(0)

  @@index([estado_operativo], map: "idx_estado")
  @@index([placa_actual], map: "idx_placa")
  @@map("neumaticos_hoja_vida")
}

model NeumaticoInspeccion {
  id_inspeccion    String    @id @db.VarChar(50)
  id_ot            String?   @db.VarChar(50)
  placa            String    @db.VarChar(20)
  fecha_inspeccion DateTime  @db.Date
  km_vehiculo      Int       @default(0)
  dias_propuestos  Int       @default(30)
  fecha_proxima    DateTime? @db.Date
  observaciones    String?   @db.Text
  inspector        String    @default("") @db.VarChar(100)
  total_llantas    Int?      @default(0)
  created_at       DateTime? @default(now()) @db.Timestamp(0)

  @@index([fecha_inspeccion], map: "idx_fecha")
  @@index([placa, fecha_inspeccion], map: "idx_neu_insp_placa_fecha")
  @@index([id_ot], map: "idx_ot")
  @@index([placa], map: "idx_placa")
  @@map("neumaticos_inspecciones")
}

model NeumaticoInspeccionDet {
  id                 Int       @id @default(autoincrement())
  id_inspeccion      String    @db.VarChar(50)
  id_neumatico       String?   @db.VarChar(50)
  posicion           String    @db.VarChar(10)
  marca              String    @db.VarChar(100)
  medida             String    @db.VarChar(50)
  modelo             String    @db.VarChar(100)
  r1                 Int
  r2                 Int
  r3                 Int
  remanente_promedio Decimal?  @db.Decimal(4, 1)
  presion_ant        Int?      @default(0)
  presion_actual     Int?      @default(0)
  estado             String    @default("NUEVA") @db.VarChar(30)
  accion             String    @default("Inspeccion") @db.VarChar(50)
  observaciones      String?   @db.Text
  alerta_cambio      Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamp(0)
  r4                 Int?      @default(0)
  rot                String?   @default("NO") @db.VarChar(50)
  foto1              String?   @db.LongText
  foto2              String?   @db.LongText
  foto3              String?   @db.LongText
  tipo_eje           String?   @db.VarChar(50)

  @@index([id_inspeccion], map: "idx_insp")
  @@index([id_inspeccion, posicion], map: "idx_insp_pos")
  @@index([posicion], map: "idx_pos")
  @@map("neumaticos_inspecciones_det")
}

model NeumaticoRotacion {
  id               Int       @id @default(autoincrement())
  id_ot            String?   @db.VarChar(50)
  placa            String    @db.VarChar(20)
  fecha            DateTime  @db.Date
  km_actual        Int?      @default(0)
  posicion_origen  String    @db.VarChar(10)
  posicion_destino String    @db.VarChar(10)
  id_neumatico     String?   @db.VarChar(50)
  motivo           String?   @default("Rotación preventiva") @db.VarChar(200)
  tecnico          String    @default("") @db.VarChar(100)
  created_at       DateTime? @default(now()) @db.Timestamp(0)

  @@index([placa], map: "idx_placa")
  @@map("neumaticos_rotaciones")
}

enum NeumaticosHojaVidaEstadoOperativo {
  Montada
  Stock_Taller @map("Stock Taller")
  En_Rencauche @map("En Rencauche")
  Desecho
}
