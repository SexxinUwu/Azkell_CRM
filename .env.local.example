# Entorno de pruebas en tu PC. Copia este archivo como .env.local (no se sube al repositorio) y completa la clave.
# El servidor lee primero .env.local; lo que no esté aquí sale del .env. Con estos valores NO se toca producción.

# Base de datos: tu MySQL local (la copia que crea scripts/clonar_a_local.js)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=PON_AQUI_LA_CLAVE_DE_TU_MYSQL_LOCAL
DB_NAME=azkell_tenant_marsisa
DB_SSL=
LOCAL_DB_PASSWORD=PON_AQUI_LA_CLAVE_DE_TU_MYSQL_LOCAL

# Clave propia del entorno local: las sesiones de producción no valen aquí
JWT_SECRET=clave-local-solo-para-pruebas-cambiala
APP_URL=http://localhost:3000
RP_ID=localhost
RP_ORIGIN=http://localhost:3000

# Servicios externos APAGADOS en local (vacío = no envía nada a nadie ni emite documentos)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
GERENCIA_WHATSAPP=
APISUNAT_PERSONA_ID=
APISUNAT_PERSONA_TOKEN=
REMOTE_FUEL_DATABASE=
REMOTE_FUEL_HOST=
REMOTE_FUEL_USER=
REMOTE_FUEL_PASSWORD=
