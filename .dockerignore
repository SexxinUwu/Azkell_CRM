# Ignorar dependencias locales
node_modules/
npm-debug.log

# Ignorar archivos y carpetas pesadas de compilación móvil
android/
ios/

# Ignorar control de versiones e IDEs
.git/
.gitignore
.vscode/
.claude/
.agents/
.gemini/

# Ignorar archivos temporales y logs
*.log
tmp*
scratch/
diff.txt
test.txt
*.sql

# Excepto: migraciones de Prisma (las usa prisma migrate deploy)
!prisma/**/migration.sql

# La app nueva se compila dentro de la imagen
dist/
